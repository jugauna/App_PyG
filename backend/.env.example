# Nivel de log de la API (opcional): INFO por defecto; DEBUG para trazas por pozo (logger.debug).
# LOG_LEVEL=DEBUG

# Directorio con Parquet anual (opcional): se leen wells_2025.parquet, wells_2026.parquet, etc.
# También puede apuntar a un único archivo .parquet (modo legacy, mismo fichero para cualquier año).
# Por defecto: <raíz_proyecto>/data/parquet/wells_{anio}.parquet
# WELLS_PARQUET=C:/ruta/data/parquet
